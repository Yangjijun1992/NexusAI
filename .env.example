# NexusAI Lite - 密钥与路径配置示例
# 重要：不要在此文件提交真实密钥！本文件仅声明变量名称与占位值。
# 复制为 .env 后填入真实值，并确保 .env 被 .gitignore 忽略。

# DeepSeek API Key（provider api key，存于环境变量，绝不进入代码/日志/Prompt）
# 示例格式（占位，非真实）：sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=

# 数据目录（覆盖默认 ~/.local/share/nexusai-lite；可选）
NEXUSAI_DATA_DIR=

# 数据库文件路径（覆盖默认 data_dir/nexusai.db；可选）
NEXUSAI_DB_PATH=
